<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The AudioComponents array IS the registration. A host reads this to discover
  the plugin and to find the factory function by name; a bundle without it is
  simply never seen, however correct the code inside is.

  `type` distinguishes an effect (aufx) from an instrument (aumu), and the host
  files them in different menus. It comes from sonore_add_au's TYPE, aufx when
  none is given; an instrument must pass TYPE aumu, or no player finds it.
  (No double hyphen anywhere in this comment: XML forbids one there.)
  The name a host lists is "<VENDOR>: <NAME>", from the same call.
-->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>English</string>
  <key>CFBundleExecutable</key>
  <string>@SONORE_AU_NAME@</string>
  <key>CFBundleIdentifier</key>
  <string>@SONORE_AU_BUNDLE_ID@</string>
  <key>CFBundleName</key>
  <string>@SONORE_AU_NAME@</string>
  <key>CFBundlePackageType</key>
  <string>BNDL</string>
  <key>CFBundleShortVersionString</key>
  <string>@SONORE_AU_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SONORE_AU_VERSION@</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>AudioComponents</key>
  <array>
    <dict>
      <key>name</key>
      <string>@SONORE_AU_VENDOR@: @SONORE_AU_DISPLAY_NAME@</string>
      <key>description</key>
      <string>@SONORE_AU_DISPLAY_NAME@</string>
      <key>factoryFunction</key>
      <string>SonoreAUFactory</string>
      <key>type</key>
      <string>@SONORE_AU_TYPE@</string>
      <key>subtype</key>
      <string>@SONORE_AU_SUBTYPE@</string>
      <key>manufacturer</key>
      <string>@SONORE_AU_MANUFACTURER@</string>
      <key>version</key>
      <integer>@SONORE_AU_VERSION_INT@</integer>
      <key>sandboxSafe</key>
      <true/>
    </dict>
  </array>
</dict>
</plist>
