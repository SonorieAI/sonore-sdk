// @NAME@ -- an instrument built on the Sonore SDK.
//
// A plugin is a SonoreDsp struct, a parameter table, a descriptor and one
// include at the end; the same file builds the CLAP, VST3, AU, LV2 and the
// standalone app (see CMakeLists.txt). This one is an eight-voice saw synth,
// to be replaced by your own sound.
#define SONORE_NUM_PARAMS 3
#include <sonore/dsp.h>

namespace {

struct Voice {
  sonore::Oscillator osc;
  sonore::ADSR env;
  float velocity = 0.0f;

  void setSampleRate(float sampleRate) {
    osc.setSampleRate(sampleRate);
    env.setSampleRate(sampleRate);
    env.reset(); // silent until the next note
  }
  void setEnvelope(float attack, float release) {
    sonore::ADSR::Parameters p;
    p.attack = attack;
    p.decay = 0.2f;
    p.sustain = 0.7f;
    p.release = release;
    env.setParameters(p);
  }
  // VoiceManager calls these four.
  void noteOn(int note, float vel) {
    velocity = vel;
    osc.setFreq((float) sonore::MidiMessage::getMidiNoteInHertz(note));
    osc.reset();
    env.noteOn();
  }
  void noteOff() { env.noteOff(); }
  bool isActive() const { return env.isActive(); }
  float render() { return osc.saw() * env.getNextSample() * velocity; }
};

} // namespace

struct SonoreDsp {
  sonore::VoiceManager<Voice, 8> voices;
  sonore::Smooth levelSm;
  float lastAttack = -1.0f, lastRelease = -1.0f;
  bool fresh = true;

  // Called before audio starts and whenever the rate or block size changes.
  // It may also run on the audio thread (see the SDK README, "What runs
  // where"), so it allocates nothing.
  void prepare(const sonore::ProcessSpec& spec) {
    voices.allNotesOff();
    for (int i = 0; i < voices.kNumVoices; ++i)
      voices.voice(i).setSampleRate((float) spec.sampleRate);
    levelSm.setup((float) spec.sampleRate, 20.0f);
    lastAttack = lastRelease = -1.0f;
    fresh = true;
  }

  // Taking a MidiBuffer is what makes this an instrument in every format.
  // The audio thread: no allocation, no locks, no files.
  void process(sonore::AudioBlock<float>& io, const float* p, sonore::MidiBuffer& midi) {
    if (p[0] != lastAttack || p[1] != lastRelease) { // only when a control moved
      for (int i = 0; i < voices.kNumVoices; ++i) voices.voice(i).setEnvelope(p[0], p[1]);
      lastAttack = p[0];
      lastRelease = p[1];
    }
    const float level = sonore::dbToGain(p[2]);
    if (fresh) {
      levelSm.snap(level);
      fresh = false;
    }
    float* left = io.getChannelPointer(0);
    float* right = io.getNumChannels() > 1 ? io.getChannelPointer(1) : nullptr;
    auto event = midi.begin();
    const auto end = midi.end();
    for (size_t i = 0; i < io.getNumSamples(); ++i) {
      // Each event at its own frame, not the block's first: that is what
      // keeps an instrument in time.
      while (event != end && (size_t) event->samplePosition <= i) {
        const sonore::MidiMessage& m = event->getMessage();
        if (!sonore::applyPedals(voices, m)) { // sustain, sostenuto, all-notes-off
          if (m.isNoteOn())
            voices.noteOn(m.getNoteNumber(), m.getFloatVelocity(), m.getChannel() - 1);
          else if (m.isNoteOff())
            voices.noteOff(m.getNoteNumber(), m.getChannel() - 1);
        }
        ++event;
      }
      const float s = voices.render() * levelSm.next(level);
      left[i] = s;
      if (right) right[i] = s;
    }
  }

  // A host's voice meter.
  int voiceCapacity() const { return voices.kNumVoices; }
  int activeVoices() const {
    int n = 0;
    for (int i = 0; i < voices.kNumVoices; ++i)
      if (voices.voice(i).isActive()) ++n;
    return n;
  }
};

#include <sonore/plugin.h>

// POSITIONAL: a parameter's index is its identity in every saved session.
// Once this ships, only ever append rows.
static const sonore::ParamInfo kParamTable[SONORE_NUM_PARAMS] = {
    // id, name, unit, min, max, default
    {"attack", "Attack", "s", 0.001f, 2.0f, 0.01f},
    {"release", "Release", "s", 0.01f, 4.0f, 0.3f},
    {"level", "Level", "dB", -40.0f, 6.0f, -12.0f},
};

static const sonore::PluginDescriptor kDesc = {
    // The id is this plugin's identity to every host and session: unique
    // per product, and never changed once shipped. Keep the version equal
    // to VERSION in CMakeLists.txt.
    "@ID@", "@NAME@", "@VENDOR@", "@VERSION@",
    "@DESCRIPTION@",
    "@URL@",
    true, // an instrument
    kParamTable, SONORE_NUM_PARAMS,
    nullptr, 0, // no factory presets
    "synth",    // the category hosts file it under
};

#include <sonore/formats.h> // CLAP, and every format this target is built as
