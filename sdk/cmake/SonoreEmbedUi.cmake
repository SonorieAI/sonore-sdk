# Sonore SDK: compiles a web editor's folder into a header (sonore_add_ui).
#
# Run in script mode at BUILD time, so editing a file in the folder rebuilds
# the plugin with it:
#
#   cmake -DDIR=<folder> -DOUT=<header> [-DENTRY=index.html] -P SonoreEmbedUi.cmake
#
# Every file becomes a string literal of hex escapes, cut into pieces of 3000
# bytes. The size of a piece is the one thing here that is not free: MSVC
# refuses a single literal over 16380 characters (C2026), and a piece of 3000
# bytes is 12000 characters escaped. Adjacent pieces concatenate into one
# array, which every compiler takes at any length; a 1.3 MB folder (three.js
# and an HDRI) embeds in about two seconds and compiles in about one.
#
# Hidden files (.DS_Store, .gitkeep) and Thumbs.db stay out. The build runs
# this only when a file in the folder is newer than the header, so the header
# is always written: one left untouched would stay older than the file that
# triggered it, and every later build would run this again.

# A script run with -P inherits none of the project's policies, so it sets its
# own. Without this line CMake 3.x reads `IN_LIST` under the OLD policy
# (CMP0057) and stops with "Unknown arguments specified". CMake 4 has removed
# that OLD behaviour, so a machine running 4.x never shows the failure.
cmake_minimum_required(VERSION 3.21)

if(NOT DIR OR NOT OUT)
  message(FATAL_ERROR "SonoreEmbedUi.cmake needs -DDIR=<folder> and -DOUT=<header>")
endif()
file(GLOB_RECURSE _files RELATIVE "${DIR}" "${DIR}/*")
list(SORT _files)
set(_kept "")
foreach(_f IN LISTS _files)
  get_filename_component(_name "${_f}" NAME)
  if(_name MATCHES "^\\." OR _name STREQUAL "Thumbs.db" OR _f MATCHES "(^|/)\\.")
    continue()
  endif()
  list(APPEND _kept "${_f}")
endforeach()
if(NOT _kept)
  message(FATAL_ERROR "sonore_add_ui: ${DIR} has no files to serve")
endif()

# A C string literal for any text: every byte as \xNN, so a quote, a
# backslash or a byte of UTF-8 in a file name cannot end the literal early.
function(_sonore_c_literal OUT TEXT)
  string(HEX "${TEXT}" _hex)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" _esc "${_hex}")
  set(${OUT} "\"${_esc}\"" PARENT_SCOPE)
endfunction()

set(_body "// Generated by sonore_add_ui() from ${DIR}.\n// Do not edit: it is rewritten from the folder on every build.\n#pragma once\n#include <sonore/ui_assets.h>\n\nnamespace sonore_ui_generated {\n")
set(_table "")
set(_i 0)
foreach(_f IN LISTS _kept)
  file(READ "${DIR}/${_f}" _hex HEX)
  string(LENGTH "${_hex}" _n)
  math(EXPR _bytes "${_n} / 2")
  set(_pieces "")
  set(_pos 0)
  while(_pos LESS _n)
    string(SUBSTRING "${_hex}" ${_pos} 6000 _piece)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "\\\\x\\1" _piece "${_piece}")
    string(APPEND _pieces "    \"${_piece}\"\n")
    math(EXPR _pos "${_pos} + 6000")
  endwhile()
  if(_bytes EQUAL 0)
    set(_pieces "    \"\"\n")
  endif()
  _sonore_c_literal(_path "${_f}")
  string(APPEND _body "// ${_f}: ${_bytes} bytes\nstatic const char d${_i}[] =\n${_pieces};\n")
  string(APPEND _table "    {${_path}, (const unsigned char*) d${_i}, ${_bytes}u},\n")
  math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _body "\nstatic const sonore::UiAsset kItems[] = {\n${_table}};\n\n} // namespace sonore_ui_generated\n\n")

if(ENTRY)
  if(NOT ENTRY IN_LIST _kept)
    message(FATAL_ERROR "sonore_add_ui: ENTRY ${ENTRY} is not a file in ${DIR}")
  endif()
  _sonore_c_literal(_entry "${ENTRY}")
  string(APPEND _body "#define SONORE_UI_HAS_ENTRY 1\n")
else()
  set(_entry "nullptr")
endif()
string(APPEND _body "static const sonore::UiAssets kSonoreUiAssets = {\n    sonore_ui_generated::kItems, ${_i}u, ${_entry}};\n")

file(WRITE "${OUT}" "${_body}")
